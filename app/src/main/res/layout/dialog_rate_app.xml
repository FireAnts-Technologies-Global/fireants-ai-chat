<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:background="#aabbcc">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_remove_bg_mode_unselected"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_18sdp"
            android:paddingVertical="@dimen/_18sdp">

            <com.willy.ratingbar.ScaleRatingBar
                android:id="@+id/simpleRatingBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/_6sdp"
                app:srb_clickable="true"
                app:srb_drawableEmpty="@drawable/ic_ratingbar_star_off"
                app:srb_drawableFilled="@drawable/ic_ratingbar_star_on"
                app:srb_scrollable="true"
                app:srb_stepSize="1" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="5dp"
                android:text="@string/enjoying_ai_chat"
                android:textColor="@color/white"
                android:textSize="@dimen/_15sdp" />

            <TextView
                android:id="@+id/tvContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/_30sdp"
                android:layout_marginVertical="10dp"
                android:fontFamily="@font/regular"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="10dp"
                android:text="@string/rate_us_on_the_google_play"
                android:textColor="#A7B0C0"
                android:textSize="@dimen/_13sdp" />

            <LinearLayout
                android:id="@+id/layoutFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/edtReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_feedback"
                    android:hint="@string/feedback_reason_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="@dimen/_10sdp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="@dimen/_12sdp" />

                <EditText
                    android:id="@+id/edtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/bg_edittext_feedback"
                    android:gravity="top"
                    android:hint="@string/feedback_description_hint"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:padding="@dimen/_10sdp"
                    android:textColor="@color/white"
                    android:textColorHint="#80FFFFFF"
                    android:textSize="@dimen/_12sdp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRateNow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginHorizontal="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:backgroundTint="#E8C3AC"
                android:fontFamily="@font/bold"
                android:text="@string/rate_now"
                android:textAllCaps="false"
                android:textSize="@dimen/_13sdp"
                app:cornerRadius="@dimen/_57sdp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotNow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginHorizontal="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:backgroundTint="#1E1E25"
                android:fontFamily="@font/bold"
                android:text="@string/not_now"
                android:textAllCaps="false"
                android:textSize="@dimen/_13sdp"
                app:cornerRadius="@dimen/_57sdp"
                app:strokeColor="#1FFFFFFF"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </FrameLayout>
</layout>