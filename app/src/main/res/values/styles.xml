<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="rounded_corner">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_54sdp</item>
        <item name="android:background">@drawable/bg_setting_item_ripple</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/_14sdp</item>
    </style>

    <style name="SettingIconContainer">
        <item name="android:layout_width">@dimen/_34sdp</item>
        <item name="android:layout_height">@dimen/_34sdp</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:background">@drawable/bg_setting_icon_container</item>
    </style>

    <style name="SettingIcon">
        <item name="android:layout_width">@dimen/_18sdp</item>
        <item name="android:layout_height">@dimen/_18sdp</item>
        <item name="android:layout_gravity">center</item>
        <item name="tint">#FF41BC</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_marginStart">@dimen/_12sdp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_13ssp</item>
    </style>

    <style name="SettingChevron">
        <item name="android:layout_width">@dimen/_16sdp</item>
        <item name="android:layout_height">@dimen/_16sdp</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="tint">@color/setting_chevron</item>
    </style>

    <style name="SettingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">@dimen/_54sdp</item>
        <item name="android:layout_marginEnd">@dimen/_14sdp</item>
        <item name="android:background">@color/setting_divider</item>
    </style>

    <style name="text_regular">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:gravity">start</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>


    <style name="text_bold" parent="text_regular">
        <item name="android:fontFamily">@font/bold</item>
    </style>


    <style name="text_regular_12" parent="text_regular">
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>


    <style name="text_bold_16" parent="text_bold">
        <item name="android:textSize">@dimen/_16ssp</item>
    </style>


    <style name="text_bold_10" parent="text_bold">
        <item name="android:textSize">@dimen/_10ssp</item>
    </style>


</resources>
